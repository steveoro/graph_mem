-# Role-aware navigation (UI-1). Operator-only items sit inside `can_write?`; that is
-# cosmetic, the server refuses guests on those routes anyway (RoleAuthorization).
-# Route helpers go through main_app: the layout also renders inside Mission Control.
- review_path = main_app.review_path
- on_review = current_page?(review_path)
- on_scan_review = on_review && params[:view] == "scan"
%nav.ui-sidebar{ "aria-label": t("ui.nav.label"), data: { controller: "nav", action: "keydown.esc@window->nav#close" } }
  .ui-sidebar__top
    = link_to (can_write? ? main_app.root_path : main_app.search_path), class: "ui-sidebar__brand" do
      GraphMem
      %span.ui-sidebar__version v#{GraphMem::VERSION}
    %button.ui-sidebar__toggle{ type: "button", "aria-expanded": "false", "aria-controls": "ui-sidebar-menu",
      "aria-label": t("ui.nav.toggle"), data: { action: "nav#toggle", nav_target: "toggle", testid: "nav-toggle" } }
      %span{ "aria-hidden": "true" } ☰
  #ui-sidebar-menu.ui-sidebar__menu{ data: { nav_target: "menu" } }
    %ul.ui-sidebar__list
      - if can_write?
        %li= ui_nav_link t("ui.nav.home"), main_app.root_path, testid: "nav-home"
      %li= ui_nav_link t("ui.nav.search"), main_app.search_path, testid: "nav-search", icon: :search
      %li= ui_nav_link t("ui.nav.explore"), main_app.explore_path, testid: "nav-explore"
    - if can_write?
      %h2.ui-sidebar__heading= t("ui.nav.groups.review")
      %ul.ui-sidebar__list
        %li= ui_nav_link t("ui.nav.compaction_review"), review_path, testid: "nav-review",
          badge: ui_review_backlog_count, current: on_review && !on_scan_review
        %li= ui_nav_link t("ui.nav.scan_review"), main_app.review_path(view: "scan"),
          testid: "nav-scan-review", current: on_scan_review
      %h2.ui-sidebar__heading= t("ui.nav.groups.projects")
      -# Projects & Data pages name their entry (Projects::BaseController.nav_section).
      - section = controller.class.try(:nav_section)
      %ul.ui-sidebar__list
        %li= ui_nav_link t("projects.nav.projects"), main_app.projects_path, testid: "nav-projects", icon: :maintenance,
          current: section == :projects
        %li= ui_nav_link t("projects.nav.scans"), main_app.projects_scans_path, testid: "nav-scans", current: section == :scans
        %li= ui_nav_link t("projects.nav.imports"), main_app.projects_imports_path, testid: "nav-imports", current: section == :imports
        %li= ui_nav_link t("projects.nav.exports"), main_app.projects_exports_path, testid: "nav-exports", current: section == :exports
        %li= ui_nav_link t("projects.nav.jobs"), main_app.projects_jobs_path, testid: "nav-background-jobs", current: section == :jobs
      %h2.ui-sidebar__heading= t("ui.nav.groups.system")
      %ul.ui-sidebar__list
        %li= ui_nav_link t("ui.nav.embeddings"), main_app.operator_embeddings_path, testid: "nav-embeddings"
        %li= ui_nav_link t("ui.nav.telemetry"), main_app.operator_telemetry_path, testid: "nav-telemetry"
        %li= ui_nav_link t("ui.nav.audit_logs"), main_app.operator_audit_logs_path, testid: "nav-audit-logs"
        %li= ui_nav_link t("ui.nav.settings"), main_app.operator_settings_path, testid: "nav-settings", icon: :settings
        -# Mission Control and Swagger UI have their own layouts: skip Turbo Drive.
        %li= ui_nav_link t("ui.nav.jobs"), "/operator/jobs", testid: "nav-jobs", data: { turbo: false }
        %li= ui_nav_link t("ui.nav.api_docs"), "/api-docs/index.html", testid: "nav-api-docs", data: { turbo: false }
    .ui-sidebar__footer
      %p.ui-sidebar__user= t("ui.nav.signed_in_as", user: session[:user].presence || t("ui.nav.unknown_user"))
      - if guest_signed_in?
        %span.ui-badge{ data: { testid: "nav-guest-badge" } }= t("ui.nav.guest_badge")
      = button_to t("ui.nav.sign_out"), main_app.operator_logout_path,
        method: :delete,
        class: "ui-btn ui-sidebar__signout",
        id: "btn-operator-logout",
        data: { testid: "btn-operator-logout" }
