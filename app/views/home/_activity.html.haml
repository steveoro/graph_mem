-# The latest change sets. Status only: undo stays on the pages that own the change (Review › Resolved).
= turbo_frame_tag "home-#{section}" do
  %section.ui-card.home-card{ "aria-labelledby": "home-activity-title" }
    %h2#home-activity-title.home-card__title= t("home.activity.title")
    - if data.empty?
      %p.home-card__empty= t("home.activity.empty")
    - else
      %ul.home-list
        - data.each do |set|
          %li.home-list__item{ data: { testid: "home-activity-row" } }
            %span.ui-badge= set.kind
            %span.home-list__main= set.summary.presence || set.kind.humanize
            %span.home-list__meta= "#{set.actor || 'unknown'} · #{time_ago_in_words(set.created_at)} ago"
            - if set.undone_at
              %span.home-list__meta= t("home.activity.undone")
            - elsif set.undoable?
              %span.home-list__meta= t("home.activity.undoable_until", time: l(set.undoable_until, format: :short))
    .home-card__footer
      = link_to t("home.activity.audit_log"), operator_audit_logs_path, data: { turbo_frame: "_top" }
