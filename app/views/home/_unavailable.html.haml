-# A widget whose data couldn't be read (PagesController#home_section rescued the error): only
-# this frame says so; the others render as usual.
= turbo_frame_tag "home-#{section}" do
  %section.ui-card.home-card{ data: { testid: "home-unavailable-#{section}" } }
    %h2.home-card__title= t("home.unavailable.title", widget: t("home.unavailable.widgets.#{section}"))
    %p.home-card__empty= t("home.unavailable.body")
    .home-card__footer
      = link_to t("home.unavailable.reload"), root_path, data: { turbo_frame: "_top" }
