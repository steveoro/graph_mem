-# Search (UI-3, ui-3-plan.md): one page for operators and guests. The form is one GET with every
-# filter in the URL; GraphSearch::Page runs the same search as the MCP `search` tool. Result names
-# open the read-only entity panel in the "entity-panel" frame beside the list.
- content_for :title, @search.query.present? ? "#{@search.query} · #{t('search.title')}" : t("search.title")
- content_for :page_header, ui_page_header(t("search.title"), subtitle: t("search.subtitle"))

.search-page{ data: { controller: "search", action: "keydown@window->search#focus", testid: "search-page" } }
  = render "search/filters", search: @search

  .search-layout
    %section.search-results{ "aria-label": t("search.title"), data: { testid: "search-results" } }
      - if @search.error
        .ui-card.search-error{ role: "alert", data: { testid: "search-error" } }
          %p.search-error__title= t("search.results.error_title")
          %p= @search.error
      - elsif !@search.searched?
        %p.search-results__empty= t("search.results.prompt")
      - elsif @search.rows.empty?
        %p.search-results__empty{ data: { testid: "search-empty" } }= t("search.results.empty")
      - else
        .search-results__bar
          %span.search-results__page= t("search.results.page", page: @search.page)
          -# "Show as graph": this page's entities and the relations among them, on Explore.
          = link_to t("search.results.show_as_graph"), explore_path(ids: @search.rows.map(&:id).join(",")),
            class: "ui-btn", title: t("search.results.show_as_graph_hint"), data: { turbo_frame: "_top", testid: "search-show-graph" }
        %ol.search-results__list{ start: ((@search.page - 1) * @search.per_page) + 1 }
          = render partial: "search/result", collection: @search.rows, as: :row,
            locals: { tokens: GraphSearch::Snippets.tokens_for(@search.query) }
        %nav.search-pager{ "aria-label": "Pages" }
          - if @search.page > 1
            = link_to t("search.results.previous"), search_page_path(@search, page: @search.page - 1), class: "ui-btn",
              rel: "prev", data: { testid: "search-prev" }
          - if @search.next_page?
            = link_to t("search.results.next"), search_page_path(@search, page: @search.page + 1), class: "ui-btn",
              rel: "next", data: { testid: "search-next" }

    = turbo_frame_tag "entity-panel", class: "search-panel", data: { testid: "entity-panel" } do
      %p.search-panel__hint= t("search.results.panel_hint")
