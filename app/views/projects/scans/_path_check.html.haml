-# What ScanRootPolicy would do with a path. Two callers show the same result: the scan form's
-# live check (path_check_controller.js) and Settings › Project scans.
= turbo_frame_tag "scan-path-check", data: { path_check_target: "frame" } do
  - if result
    - if result.ok?
      %p{ data: { testid: "scan-check-result", code: result.code } }
        %span.dashboard-badge.dashboard-badge--running ✓
        %code= result.path
        - if result.warnings.any?
          %span.dashboard-alert--warning= ScanRootResolution.warning_suffix(result).strip
    - else
      %p{ data: { testid: "scan-check-result", code: result.code } }
        %span.dashboard-badge.dashboard-badge--failed= result.code
        = result.message
