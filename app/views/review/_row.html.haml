-# One suggestion in a group or a search result.
- choice = ReviewRowClassifier::CHOICE_KINDS.include?(row.kind)
- confirm = choice || !ReviewRowClassifier::SAFE_BULK_KINDS.include?(row.kind)
%div.review-row{ id: dom_id(row), data: { review_keys_target: "item", row_uuid: row.row_uuid, testid: "review-row" } }
  = link_to review_row_path(row.row_uuid), class: "review-row__open", data: { turbo_frame: "review-detail", review_keys_action: "open" } do
    %span.ui-badge= row.kind.humanize
    %span= review_row_title(row)
    %span.review-row__meta= "priority #{row.priority}#{row.confidence ? " · #{format('%.2f', row.confidence)}" : ''} · #{row.status}"
  .review-row__actions
    - if choice
      = link_to "Choose a side", review_row_path(row.row_uuid), class: "ui-btn", data: { turbo_frame: "review-detail", review_keys_action: "apply" }
    - elsif confirm
      = link_to "Apply…", review_row_preview_path(row.row_uuid), class: "ui-btn", data: { turbo_frame: "review-detail", review_keys_action: "apply" }
    - else
      = button_to "Apply", review_row_apply_path(row.row_uuid), class: "ui-btn ui-btn-primary", form: { data: { review_keys_action: "apply" } }
    = button_to "Dismiss", review_row_dismiss_path(row.row_uuid), class: "ui-btn", form: { data: { review_keys_action: "dismiss" } }
    = button_to "Snooze", review_row_snooze_path(row.row_uuid), class: "ui-btn", form: { data: { review_keys_action: "snooze" } }
