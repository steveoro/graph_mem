-# Left rail: the views of the Review page with their counts.
- items = [ [ "attention", "Needs attention", rail["attention"] ], [ "kind", "By kind", rail["kind"] ], [ "project", "By project", nil ],
  [ "errors", "Errors", rail["errors"] ], [ "scan", "Scan review", rail["scan"] ], [ "resolved", "Resolved", nil ], [ "policies", "Policies", nil ] ]
-# 1.86.2: the badges and the policy-run state refresh themselves (live_refresh_controller.js, GET /review/live).
%nav.review-rail{ "aria-label": "Review views", id: "review-rail",
  data: { controller: "live-refresh", live_refresh_url_value: review_live_path(view: view) } }
  = render "review/live_state", active: local_assigns.fetch(:active, false)
  %ul
    - items.each do |key, label, count|
      %li
        = link_to review_path(view: key), class: "review-rail__link", "aria-current": (key == view ? "page" : nil),
          data: { testid: "review-view-#{key}" } do
          = label
          - unless count.nil?
            = render "review/rail_count", key: key, count: count
  %p
    = link_to "Find & supersede", review_supersede_path, class: "review-rail__link", data: { testid: "review-find-supersede" }
  .review-rail__actions
    = button_to "Run policies now", review_run_policies_path, method: :post, params: { view: view }, class: "ui-btn",
      data: { testid: "review-run-policies" }
    %details
      %summary Import suggest-merges
      = form_with url: review_import_suggest_merges_path, method: :post, class: "ui-form" do
        = number_field_tag :threshold, nil, step: 0.01, min: 0, max: 1, placeholder: "threshold (0.3)", class: "ui-input"
        = number_field_tag :limit, nil, min: 1, placeholder: "limit (20)", class: "ui-input"
        = text_field_tag :entity_type, nil, placeholder: "entity type", class: "ui-input"
        = submit_tag "Import", class: "ui-btn"
