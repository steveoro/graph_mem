-# By kind / By project / Errors / Scan review: one line per group, ranked by priority.
- titles = { "kind" => "By kind", "project" => "By project", "errors" => "Errors", "scan" => "Scan review" }
%h2.review-heading= titles[@view]
- if @view == "kind"
  %nav.review-filters
    - (ReviewRowClassifier::IMPACT.keys + ReviewRowClassifier::ERROR_KINDS).uniq.sort.each do |kind|
      = link_to review_kind_label(kind), review_path(view: "kind", kind: kind), class: "review-filter", "aria-current": (params[:kind] == kind ? "true" : nil)
- if @groups.empty?
  %p.review-hint Nothing here.
- else
  = render partial: "review/group_card", collection: @groups, as: :group
  %nav.review-pager
    - if @page > 1
      = link_to "← Previous", review_path(request.query_parameters.merge(page: @page - 1))
    - if @groups.size == 25
      = link_to "Next →", review_path(request.query_parameters.merge(page: @page + 1))
