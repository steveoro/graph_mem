.ui-card.ui-auth__card
  %h1.ui-page-header__title= t("operator.sessions.title")
  %p.ui-page-header__subtitle= t("operator.sessions.subtitle")

  = form_with url: operator_session_path, method: :post, local: true, class: "ui-form", data: { testid: "operator-login-form" } do
    .ui-field
      %label.ui-label{ for: "operator_username" }= t("operator.sessions.username_label")
      = text_field_tag :username, params[:username],
        id: "operator_username",
        class: "ui-input",
        required: true,
        autocomplete: "username",
        data: { testid: "operator-login-username" }

    .ui-field
      %label.ui-label{ for: "operator_password" }= t("operator.sessions.password_label")
      = password_field_tag :password, nil,
        id: "operator_password",
        class: "ui-input",
        required: true,
        autocomplete: "current-password",
        data: { testid: "operator-login-password" }

    = submit_tag t("operator.sessions.sign_in"),
      class: "ui-btn ui-btn-primary",
      id: "btn-operator-sign-in",
      data: { testid: "btn-operator-sign-in" }
