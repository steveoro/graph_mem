.dashboard-page
  %header.dashboard-header
    %div
      %h1.dashboard-header__title Maintenance Hub
      %p.dashboard-header__subtitle Import, export, cleanup, background jobs and project scans
    = link_to "Back to Home", root_path, class: "dashboard-btn dashboard-btn--secondary"

  %section.dashboard-actions-grid
    .dashboard-card
      %h2.dashboard-card__title Export
      %p.dashboard-card__summary Select root nodes to export as JSON (includes descendants).
      - if @root_nodes.any?
        = form_with url: export_data_exchange_index_path, method: :get, local: true, class: "maintenance-export-form", data: { turbo: false } do
          .maintenance-export-list
            - @root_nodes.each do |entity|
              %label.maintenance-export-item
                = check_box_tag "ids[]", entity.id, false, class: "maintenance-export-checkbox"
                %span
                  %strong= entity.name
                  %span.text-gray-500 (#{entity.entity_type})
                  — #{entity.memory_observations_count} observations
          = submit_tag "Export selected", class: "dashboard-btn dashboard-btn--primary", id: "btn-maintenance-export"
      - else
        %p.dashboard-card__empty No root nodes available for export.

    .dashboard-card
      %h2.dashboard-card__title Import
      %p.dashboard-card__summary Upload a GraphMem JSON export file for review and merge decisions.
      = form_with url: import_upload_data_exchange_index_path, method: :post, local: true, multipart: true, class: "maintenance-import-form" do
        .maintenance-import-field
          = file_field_tag :file, accept: "application/json,.json", required: true, class: "maintenance-import-file", id: "maintenance-import-file"
          %label.maintenance-import-file-label{ for: "maintenance-import-file", id: "btn-maintenance-choose-file", data: { testid: "btn-maintenance-choose-file" } }
            = dashboard_icon(:file_choose, css_class: "maintenance-import-file-icon")
            %span.maintenance-import-file-text= t("dashboard.maintenance.choose_file")
        = submit_tag "Upload for review", class: "dashboard-btn dashboard-btn--primary", id: "btn-maintenance-import"

    .dashboard-card
      %h2.dashboard-card__title Cleanup
      %p.dashboard-card__summary
        Orphan entities: #{@graph_stats[:orphan_count]}.
      %p.dashboard-card__hint
        Use the graph explorer context menu for per-node merge, move, and relation edits.
        Run garbage-collection diagnostics under
        = link_to "Background jobs", maintenance_path(anchor: "background-jobs"), class: "dashboard-link"
        for orphan and duplicate observation reports.
      .dashboard-card__actions
        = link_to "Open graph explorer", graph_path, class: "dashboard-btn dashboard-btn--secondary", id: "btn-maintenance-graph"

  - snapshot = @snapshot
  %section#background-jobs.dashboard-state-grid.dashboard-state-grid--2x2{ "aria-label": "Background jobs" }
    = render "maintenance/dream_state_compactor_card", compaction: snapshot[:compaction], cursor_entity: snapshot[:cursor_entity],
      schedules: snapshot[:schedules], latest_reports: snapshot[:latest_reports]
    = render "maintenance/garbage_collector_card", latest_reports: snapshot[:latest_reports], schedules: snapshot[:schedules],
      operation: snapshot.dig(:operations, :garbage_collection)

  %section#project-scans.dashboard-state-grid.dashboard-state-grid--2x2{ "aria-label": "Project scans" }
    = render "maintenance/project_scans_card", project_scans: snapshot.dig(:operations, :project_scans) || [],
      scan_reviews: snapshot[:scan_reviews] || { count: 0, items: [] }
    = render "maintenance/project_scan_skill_companion_card", project_scan_skills: snapshot.dig(:operations, :project_scan_skills) || []

  %section#mcp-clients.dashboard-state-grid{ "aria-label": "MCP clients" }
    = render "maintenance/agent_contexts_card", agent_contexts: snapshot[:agent_contexts]

  %section.dashboard-details
    = render "maintenance/reports_details", latest_reports: snapshot[:latest_reports], compaction: snapshot[:compaction]
