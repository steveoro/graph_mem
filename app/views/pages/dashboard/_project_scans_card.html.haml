- scans = project_scans
- scan_reviews = local_assigns[:scan_reviews] || { count: 0, items: [] }
.dashboard-card.dashboard-card--state{ data: { testid: "dashboard-project-scans-card" } }
  .dashboard-card__header
    %h2.dashboard-card__title Project Scans
    %span.dashboard-card__hint Recent source scans
  .dashboard-card__body
    .dashboard-card__section{ data: { testid: "dashboard-project-scan-trigger" } }
      %h3.dashboard-card__subtitle Trigger scan
      = form_with url: project_scans_path, method: :post, local: true, html: { class: "project-scan-form", data: { testid: "project-scan-trigger-form" } } do
        .project-scan-form__field
          = label_tag :project_root, "Project root"
          = text_field_tag :project_root, nil, placeholder: "/path/to/project", required: true, class: "project-scan-form__input"
        .project-scan-form__field
          = label_tag :project_name, "Project name (optional)"
          = text_field_tag :project_name, nil, placeholder: "Project name", class: "project-scan-form__input"
        .project-scan-form__field
          = label_tag :aliases, "Aliases (optional)"
          = text_field_tag :aliases, nil, placeholder: "alias1, alias2", class: "project-scan-form__input"
        .project-scan-form__field
          = label_tag :mode, "Mode"
          = select_tag :mode, options_for_select(ScanProjectTool::MODES, "initial"), class: "project-scan-form__input"
        .project-scan-form__field
          = label_tag :file_globs, "File globs (optional)"
          = text_area_tag :file_globs, nil, rows: 2, placeholder: "README*, package.json, ...", class: "project-scan-form__input"
        .project-scan-form__field.project-scan-form__field--inline
          = label_tag :dry_run, "Dry run"
          = check_box_tag :dry_run, "1", false, class: "project-scan-form__checkbox"
        = submit_tag "Start scan", class: "dashboard-btn dashboard-btn--primary"

    - if scans.any?
      .dashboard-stat-chips
        = dashboard_stat_chip("Total", scans.count)
        = dashboard_stat_chip("Running", scans.count { |s| s[:status] == "running" })
        = dashboard_stat_chip("Completed", scans.count { |s| s[:status] == "completed" })
        = dashboard_stat_chip("Failed", scans.count { |s| s[:status] == "failed" })

      %table.project-scans-table
        %thead
          %tr
            %th Project
            %th Status
            %th Mode
            %th Phase
            %th Progress
            %th
        %tbody
          - scans.each do |scan|
            - project_entity_id = scan.dig(:details, "project_entity_id")
            - row_data = { operation_progress_id: scan[:operation_id], testid: "project-scan-row-#{scan[:operation_id]}" }
            - if scan[:status].in?(%w[running pending paused])
              - row_data[:controller] = "operation-progress"
              - row_data[:operation_progress_operation_id_value] = scan[:operation_id]
            %tr.project-scans-table__row{ data: row_data }
              %td.project-scans-table__project
                - if project_entity_id
                  = link_to project_scan_name(scan), graph_path(scoped_entity_id: project_entity_id), class: "dashboard-link", id: "link-project-scan-entity-#{scan[:operation_id]}"
                - else
                  = project_scan_name(scan)
              %td= dashboard_status_badge(scan[:status], data: { progress_status: true })
              %td= scan.dig(:details, "mode").presence || "—"
              %td
                %span{ data: { progress_phase: true } }= project_scan_phase_label(scan[:phase])
              %td.project-scans-table__progress
                %progress{ max: 100, value: scan[:percentage] || 0 }
                %span{ data: { progress_percentage: true } }= "#{scan[:percentage]}%"
              %td.project-scans-table__actions
                = link_to "Details", api_v1_scan_project_path(scan[:operation_id]), class: "dashboard-btn dashboard-btn--secondary", target: "_blank", id: "link-project-scan-details-#{scan[:operation_id]}"
                - if scan.dig(:details, "fallback")
                  %span.dashboard-card__hint{ title: scan.dig(:details, "fallback_reason") } Fallback

      - latest = scans.first
      - if latest
        %details.dashboard-card__details{ data: { testid: "dashboard-project-scans-latest-details" } }
          %summary Latest scan details
          %pre.dashboard-code= JSON.pretty_generate(latest)
    - else
      %p.dashboard-card__empty{ data: { testid: "dashboard-project-scans-empty" } }
        No project source scans yet.

  - if scan_reviews[:count].positive?
    .dashboard-card__section{ data: { testid: "dashboard-scan-reviews-section" } }
      %h3.dashboard-card__subtitle
        Pending Scan Reviews
        %span.dashboard-card__hint (#{scan_reviews[:count]} total)
      %ul.dashboard-scan-reviews
        - scan_reviews[:items].each do |row|
          %li.dashboard-scan-review{ data: { testid: "dashboard-scan-review-#{row.row_uuid}" } }
            .dashboard-scan-review__summary= scan_review_item_label(row)
            .dashboard-scan-review__actions
              = form_with url: compaction_review_action_data_exchange_index_path, method: :post, local: true, html: { class: "dashboard-scan-review__form" } do
                = hidden_field_tag :item_id, row.row_uuid
                = hidden_field_tag :report_type, "scan_review"
                = hidden_field_tag :return_to, "dashboard"
                = hidden_field_tag :status, "active"
                = button_tag "Approve", name: "review_action", value: "apply", type: :submit, class: "dashboard-btn dashboard-btn--primary dashboard-btn--small", data: { turbo_confirm: "Approve this suggestion?" }
                = button_tag "Dismiss", name: "review_action", value: "dismiss", type: :submit, class: "dashboard-btn dashboard-btn--secondary dashboard-btn--small"

  .dashboard-card__actions
    = link_to "Review scan suggestions", compaction_review_data_exchange_index_path(report_type: "scan_review"), class: "dashboard-btn dashboard-btn--secondary", id: "btn-project-scans-review"
    = link_to "Refresh", root_path, class: "dashboard-btn dashboard-btn--secondary", id: "btn-project-scans-refresh"
