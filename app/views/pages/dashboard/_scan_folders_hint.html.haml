-# Under the project path field of both scan forms (mcp plan PR-0 §0.6). Rendered twice per page,
-# so the status is computed once.
- status = (@scan_status ||= ScanRootPolicy.status)
- if status[:enabled]
  %p.project-scan-form__hint{ data: { testid: "scan-folders-hint" } }
    Scannable folders:
    = status[:allowed_roots].presence&.join(", ") || "none yet (create a folder from the subfolder filter)"
    = link_to "Settings › Project scans", operator_settings_path(tab: "project_scans")
- else
  %p.dashboard-alert--danger{ data: { testid: "scans-disabled-hint" } }
    - if !status[:scans_switch]
      Scans are switched off (GRAPH_MEM_SCANS=off).
    - elsif status[:mode] == "container"
      Scans are disabled: nothing is mounted for graph_mem to read.
    - else
      = "Scans are disabled: #{status[:hard_roots].filter_map { |root| root[:error] }.join('; ').presence || 'no usable scan root'}."
    = link_to "Settings › Project scans", operator_settings_path(tab: "project_scans")
