-# Home (UI-2b, ui-dashboard-plan.md §2.2): operator only and status only. Its one form is the
-# quick search; every action lives on the page a widget links to. Each widget is a lazy Turbo
-# Frame (PagesController#home_section), so a slow check never holds up the page.
- content_for :title, t("home.title")
- content_for :page_header, ui_page_header(t("home.title"), subtitle: t("home.subtitle"))

.home{ data: { controller: "quick-search", action: "keydown@window->quick-search#focus" } }
  = form_with url: search_path, method: :get, class: "home-search", role: "search", data: { testid: "home-quick-search", turbo_frame: "_top" } do
    %label.ui-label{ for: "home-search-q" }= t("home.search.label")
    .home-search__row
      = search_field_tag :q, nil, id: "home-search-q", class: "ui-input", placeholder: t("home.search.placeholder"),
        autocomplete: "off", data: { quick_search_target: "input" }
      = submit_tag t("home.search.submit"), class: "ui-btn ui-btn-primary", name: nil

  .home-grid
    - @sections.each do |section|
      = turbo_frame_tag "home-#{section}", src: home_section_path(section), loading: :lazy,
        class: "home-widget home-widget--#{section}", data: { testid: "home-frame-#{section}" } do
        %section.ui-card.home-card
          %p.home-card__loading{ "aria-live": "polite" }= t("home.loading")
