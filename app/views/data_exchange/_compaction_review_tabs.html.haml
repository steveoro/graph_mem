-# Status + kind tab counts. Rendered inside #review-tabs so a turbo-stream
-# row action can refresh the counts without a full reload (a stale "Active (4)"
-# after a removal was the round-2 nit).
- if @stats
  .flex.flex-wrap.gap-2.mb-4
    - { "" => "All", "active" => "Active", "ignored" => "Ignored", "dismissed" => "Dismissed", "approved" => "Approved" }.each do |status, label|
      - count = status == "" ? @stats.values.sum : (@stats[status] || 0)
      - active_class = (@status_filter == status) ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300"
      = link_to "#{label} (#{count})", compaction_review_data_exchange_index_path(status: status, kind: @kind_filter, q: @q, report_type: (@report_type unless @report_type == "compaction_review")), class: "rounded px-3 py-1 text-sm #{active_class}"

-# Kind filter + search: the controller already accepted params[:kind];
-# this surfaces it. Kind tabs keep status/q so filtering composes.
- if @kind_counts&.any?
  .flex.flex-wrap.gap-2.mb-4.items-center
    %span.text-sm.text-gray-600.mr-1 Kind:
    - all_class = @kind_filter.nil? ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300"
    = link_to "All (#{@kind_counts.values.sum})", compaction_review_data_exchange_index_path(status: (@status_filter == "active" ? nil : @status_filter), q: @q, report_type: (@report_type unless @report_type == "compaction_review")), class: "rounded px-3 py-1 text-sm #{all_class}"
    - @kind_counts.sort.each do |kind, count|
      - active_class = (@kind_filter == kind) ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300"
      = link_to "#{kind.tr('_', ' ')} (#{count})", compaction_review_data_exchange_index_path(status: (@status_filter == "active" ? nil : @status_filter), kind: kind, q: @q, report_type: (@report_type unless @report_type == "compaction_review")), class: "rounded px-3 py-1 text-sm #{active_class}"
