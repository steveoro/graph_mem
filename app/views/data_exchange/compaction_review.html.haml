- review_title = @report_type == "scan_review" ? "Scan Review" : "Compaction Review"
.w-full{ data: { controller: "compaction-review" } }
  - content_for :title, review_title
  %h1.text-2xl.font-bold.mb-4= review_title

  - if @report
    %p.text-sm.text-gray-600.mb-4
      Report ##{@report.id} — #{@active_count} active suggestion#{"s" unless @active_count == 1}
      %span.text-gray-400
        (created #{l(@report.created_at, format: :short)})

  - if @report_type == "compaction_review"
    .bg-white.border.rounded.p-4.mb-6.shadow-sm
      %h2.font-semibold.mb-2 Seed from Suggest Merges
      = form_with url: compaction_review_import_suggest_merges_data_exchange_index_path, method: :post, local: true do
        .flex.flex-wrap.gap-4.items-end
          .field
            = label_tag :threshold, "Threshold", class: "block text-sm font-medium text-gray-700"
            = number_field_tag :threshold, 0.3, step: 0.01, min: 0, max: 1, class: "mt-1 block rounded border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          .field
            = label_tag :limit, "Limit", class: "block text-sm font-medium text-gray-700"
            = number_field_tag :limit, 20, min: 1, max: 100, class: "mt-1 block rounded border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          .field
            = label_tag :entity_type, "Entity type", class: "block text-sm font-medium text-gray-700"
            = text_field_tag :entity_type, nil, placeholder: "Optional", class: "mt-1 block rounded border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          = submit_tag "Import suggestions", class: "rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"

  -# Turbo-stream row actions replace this container so tab/kind counts stay
  -# current after a row changes status.
  #review-tabs
    = render "data_exchange/compaction_review_tabs"

  = form_with url: compaction_review_data_exchange_index_path, method: :get, local: true, html: { class: "mb-4 flex flex-wrap items-center gap-2" } do
    = hidden_field_tag :status, @status_filter unless @status_filter == "active"
    = hidden_field_tag :kind, @kind_filter if @kind_filter
    = hidden_field_tag :report_type, @report_type unless @report_type == "compaction_review"
    = text_field_tag :q, @q, placeholder: "Search queue…", class: "rounded border-gray-300 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500 w-64"
    = submit_tag "Search", class: "rounded bg-gray-700 px-3 py-1 text-white hover:bg-gray-800 text-sm"
    - if @q
      = link_to "Clear", compaction_review_data_exchange_index_path(status: (@status_filter == "active" ? nil : @status_filter), kind: @kind_filter, report_type: (@report_type unless @report_type == "compaction_review")), class: "text-sm text-blue-600 hover:underline"

  = form_with url: compaction_review_action_data_exchange_index_path, method: :post, local: true, html: { id: "bulk-form" } do
    = hidden_field_tag :report_type, @report_type unless @report_type == "compaction_review"
    = hidden_field_tag :status, @status_filter
    = hidden_field_tag :kind, @kind_filter if @kind_filter
    = hidden_field_tag :q, @q if @q
    = hidden_field_tag :page, params[:page]
    .mb-4.flex.flex-wrap.items-center.gap-4
      = check_box_tag "select_all", "1", false, data: { action: "change->compaction-review#toggleAll", "compaction-review-target": "selectAll" }, class: "h-4 w-4"
      = label_tag :select_all, "Select all", class: "text-sm"
      = button_tag "Apply selected", name: "review_action", value: "bulk_apply", class: "rounded bg-green-600 px-3 py-1 text-white hover:bg-green-700 text-sm", data: { turbo_confirm: "Apply all selected suggestions?" }
      = button_tag "Dismiss selected", name: "review_action", value: "bulk_dismiss", class: "rounded bg-red-600 px-3 py-1 text-white hover:bg-red-700 text-sm", data: { turbo_confirm: "Dismiss all selected suggestions?" }

  - if @items && @items.any?
    .space-y-4
      - @items.each do |row|
        = render "compaction_review_item_frame", row: row
    .mt-4
      = paginate @items, theme: 'tailwind'
  - else
    %p.text-gray-500 No #{@status_filter.presence || "all"} #{@report_type.tr("_", " ")} suggestions.

  .mt-6
    = link_to "Back to dashboard", root_path, class: "text-sm text-blue-600 hover:underline"
