!!!
%html{ lang: "en" }
  %head
    = render "layouts/head"
  %body.ui-body
    %a.ui-skip-link{ href: "#main" }= t("ui.skip_link")
    -# Signed out (e.g. a 403 page after the session expired) there is no sidebar.
    .ui-shell{ class: ("ui-shell--bare" unless signed_in?) }
      - if signed_in?
        = render "ui/sidebar"
      .ui-shell__content
        = render "ui/toasts"
        %main#main.ui-main{ tabindex: "-1" }
          = yield(:page_header) if content_for?(:page_header)
          = yield
