-# One observation; the operator can edit it (supersede, history kept) or retire it (undoable).
- mine = state[:form] == "observation_#{observation.id}"
- values = mine ? state[:values].to_h.stringify_keys : {}
- active = observation.status == MemoryObservation::ACTIVE_STATUS
%li.entity-panel__observation{ id: "observation-#{observation.id}", data: { testid: "entity-panel-observation", observation_id: observation.id } }
  %span= observation.content
  %span.entity-panel__meta
    = t("entity_panel.trust", trust: observation.trust_score.to_f.round(2))
    - if observation.perspective
      = "· #{observation.perspective}"
    - unless active
      %span.ui-badge= observation.status
  - if can_write? && active
    %details.entity-panel__edit{ open: mine }
      %summary= t("explore.panel.edit_observation")
      = form_with url: explore_observation_path(observation), method: :patch, scope: :observation, class: "entity-panel__form",
        data: { turbo_stream: true, testid: "entity-panel-edit-observation-form" } do |form|
        - if mine && state[:error]
          %p.entity-panel__error{ role: "alert", data: { testid: "entity-panel-form-error" } }= state[:error]
        = form.label :content, t("explore.panel.observation_text"), class: "ui-label", for: "observation-content-#{observation.id}"
        = form.text_area :content, value: values.fetch("content", observation.content), id: "observation-content-#{observation.id}",
          class: "ui-input", rows: 3, required: true, maxlength: ExploreEdits::Observations::MAX_OBSERVATION_LENGTH
        = render "entities/perspective_select", form: form, selected: values.fetch("perspective", observation.perspective)
        = form.submit t("explore.panel.save"), class: "ui-btn ui-btn-primary"
    = button_to t("explore.panel.retire"), retire_explore_observation_path(observation), method: :post,
      class: "ui-btn entity-panel__inline-action", form: { data: { turbo_stream: true } },
      data: { testid: "entity-panel-retire" }
