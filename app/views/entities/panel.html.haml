-# The read-only entity panel (UI-3 P4). Inside Search's "entity-panel" frame its own links
-# (relations, paging, the obsolete toggle) stay in the frame; links to other pages break out
-# with _top. Nothing here writes: no form, no edit link, for anyone.
- entity = @panel.entity
- content_for :title, entity.name
- content_for :page_header, ui_page_header(entity.name, subtitle: entity.entity_type)
= turbo_frame_tag "entity-panel" do
  %article.ui-card.entity-panel{ data: { testid: "entity-panel-body", entity_id: entity.id } }
    %header.entity-panel__header
      %h2.entity-panel__name= entity.name
      %span.ui-badge= entity.entity_type
      %p.entity-panel__crumb
        = @panel.project_name || (entity.entity_type == NodeOperationsStrategy::PROJECT_ENTITY_TYPE ? t("entity_panel.project_root") : t("search.results.global"))
    - if entity.aliases.present?
      %p.entity-panel__aliases
        %span.entity-panel__label= t("entity_panel.aliases")
        = entity.aliases
    - if entity.description.present?
      %p.entity-panel__description= entity.description
    .entity-panel__actions
      = link_to t("search.results.open_explore"), explore_path(entity_id: entity.id), class: "ui-btn",
        data: { turbo_frame: "_top", testid: "entity-panel-explore" }
      - if can_write?
        = link_to t("entity_panel.open_review"), review_path(q: entity.name), class: "ui-btn",
          data: { turbo_frame: "_top", testid: "entity-panel-review" }

    %section.entity-panel__section{ data: { testid: "entity-panel-observations" } }
      %h3.entity-panel__heading= t("entity_panel.observations")
      - if @panel.observations.empty?
        %p.entity-panel__empty= t("entity_panel.no_observations")
      - else
        %ul.entity-panel__list
          - @panel.observations.each do |observation|
            %li.entity-panel__observation{ data: { testid: "entity-panel-observation" } }
              %span= observation.content
              %span.entity-panel__meta
                = t("entity_panel.trust", trust: observation.trust_score.to_f.round(2))
                - if observation.perspective
                  = "· #{observation.perspective}"
                - unless observation.status == MemoryObservation::ACTIVE_STATUS
                  %span.ui-badge= observation.status
      .entity-panel__pager
        - if @panel.page > 1
          = link_to t("search.results.previous"), entity_panel_path(entity, page: @panel.page - 1, obsolete: (@panel.include_obsolete ? "1" : nil))
        - if @panel.more_observations?
          = link_to t("search.results.next"), entity_panel_path(entity, page: @panel.page + 1, obsolete: (@panel.include_obsolete ? "1" : nil))
        - if @panel.include_obsolete
          = link_to t("entity_panel.hide_obsolete"), entity_panel_path(entity), data: { testid: "entity-panel-obsolete-toggle" }
        - elsif @panel.inactive_observation_count.positive?
          = link_to t("entity_panel.show_obsolete", count: @panel.inactive_observation_count), entity_panel_path(entity, obsolete: "1"),
            data: { testid: "entity-panel-obsolete-toggle" }

    - { outgoing: :to_entity, incoming: :from_entity }.each do |direction, other|
      - groups = @panel.relations[direction]
      %section.entity-panel__section{ data: { testid: "entity-panel-#{direction}" } }
        %h3.entity-panel__heading= t("entity_panel.#{direction}")
        - if groups.empty?
          %p.entity-panel__empty= t("entity_panel.no_relations")
        - groups.each do |relation_type, relations|
          %h4.entity-panel__subheading
            = relation_type
            %span.entity-panel__meta= "(#{@panel.relation_counts[direction][relation_type]})"
          %ul.entity-panel__list
            - relations.each do |relation|
              - target = relation.public_send(other)
              %li
                = link_to target.name, entity_panel_path(target), data: { testid: "entity-panel-relation" }
                %span.entity-panel__meta= target.entity_type
          - hidden = @panel.relation_counts[direction][relation_type].to_i - relations.size
          - if hidden.positive?
            %p.entity-panel__meta= t("entity_panel.more_relations", count: hidden)
