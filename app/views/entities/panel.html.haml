-# The entity panel (UI-3 P4; editable for the operator since UI-4b): Search's and Explore's side
-# frame, and a plain page outside a frame. The body is entities/_panel, which Explore's edit
-# responses also stream into the frame.
- entity = @panel.entity
- content_for :title, entity.name
- content_for :page_header, ui_page_header(entity.name, subtitle: entity.entity_type)
= turbo_frame_tag "entity-panel" do
  = render "entities/panel", panel: @panel, state: {}
= render "explore/dialog_host"
