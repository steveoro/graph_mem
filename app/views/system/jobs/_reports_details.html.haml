- compaction_review = latest_reports["compaction_review"]
.system-details
  %h2.system-card__title Maintenance Reports
  %details.system-details__panel
    %summary Compaction review (#{compaction_review ? compaction_review[:count] : 0})
    - if compaction_review
      %p.system-hint
        = link_to "Open review UI", review_path, class: "ui-btn"
      %pre.system-code= JSON.pretty_generate(compaction_review[:data])
    - else
      %p.system-hint No compaction review reports.

  - %w[orphans duplicates].each do |type|
    - report = latest_reports[type]
    %details.system-details__panel
      %summary= "#{type.humanize} (#{report ? report[:count] : 0})"
      - if report
        %p.system-hint Report ##{report[:id]} — #{l(report[:created_at], format: :short)}
        %pre.system-code= JSON.pretty_generate(report[:data])
      - else
        %p.system-hint No #{type} reports yet.

  %details.system-details__panel
    %summary Full compaction snapshot
    %pre.system-code= JSON.pretty_generate(compaction)
