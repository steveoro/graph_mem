- gc_types = %w[orphans duplicates]
.ui-card.system-card--state{ data: { testid: "gc-card" } }
  .system-card__header
    %h2.system-card__title Garbage Collector
    - if operation
      = dashboard_status_badge(operation[:status])
    %span.system-hint Diagnostic reports
  .system-card__body
    -# 1.84.0: the last run's bar (system/jobs/_progress), refreshed with the page.
    - if operation
      = render "system/jobs/progress", testid: "gc-progress", percent: operation[:percentage],
        label: t("system.jobs.progress", label: operation[:phase].to_s.humanize, done: number_with_delimiter(operation[:current]),
          total: number_with_delimiter(operation[:total]), percent: operation[:percentage].to_f.round)
    - if schedules["garbage_collection"].present?
      %p.system-hint
        Scheduled: #{schedules["garbage_collection"]}
    - else
      %p.system-hint
        Not scheduled in #{Rails.env} (see production recurring config).

    .system-stats
      - gc_types.each do |type|
        - report = latest_reports[type]
        - count = report ? report[:count] : "—"
        = dashboard_stat_chip(type.humanize, count)

    %dl.system-kv
      - gc_types.each do |type|
        - report = latest_reports[type]
        %dt= "Last #{type}"
        %dd
          - if report
            #{l(report[:created_at], format: :short)} (report ##{report[:id]})
          - else
            —

  .system-actions
    = button_to "Run now", system_run_garbage_collection_path, method: :post, class: "ui-btn ui-btn-primary", id: "btn-gc-run", data: { turbo_confirm: "Run garbage collection diagnostics now?" }

  %details.system-card__details
    %summary Latest GC report samples
    - gc_types.each do |type|
      - report = latest_reports[type]
      - next unless report
      %h3.system-card__subtitle= type.humanize
      %pre.system-code= JSON.pretty_generate(report[:data])
