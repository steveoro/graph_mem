- stats = compaction[:stats] || {}
- progress = compaction[:progress]
.ui-card.system-card--state{ data: { testid: "compaction-card" } }
  .system-card__header
    %h2.system-card__title Dream State / Compactor Run
    = dashboard_status_badge(compaction[:dream_state])
    - if compaction[:run_id]
      %span.system-hint Run ##{compaction[:run_id]}
  .system-card__body
    -# 1.84.0: one bar (the run's phase and overall counts are the same numbers), refreshed with the page.
    - if progress
      - overall = progress[:overall]
      = render "system/jobs/progress", testid: "compaction-progress", percent: overall[:percent],
        label: t("system.jobs.progress", label: t("system.jobs.overall"), done: number_with_delimiter(overall[:current]),
          total: number_with_delimiter(overall[:total]), percent: overall[:percent].to_f.round)
    .system-steps
      - compaction_phases.each do |phase|
        - css = []
        - css << "system-steps__step--active" if phase_active?(compaction[:phase], phase)
        - css << "system-steps__step--complete" if phase_complete?(compaction[:phase], phase, compaction[:dream_state])
        %div{class: "system-steps__step #{css.join(' ')}"}
          %span.system-steps__label= compaction_phase_label(phase)

    %dl.system-kv
      %dt Phase
      %dd= compaction[:phase].present? ? compaction_phase_label(compaction[:phase]) : "—"
      %dt Cursor
      %dd
        - if cursor_entity
          = "#{cursor_entity[:name]} (#{cursor_entity[:entity_type]}, ##{cursor_entity[:id]})"
        - elsif compaction[:cursor_entity_id]
          = "##{compaction[:cursor_entity_id]}"
        - else
          —
      %dt Pause requested
      %dd= compaction[:pause_requested] ? "Yes" : "No"
      %dt Started
      %dd= format_dashboard_time(compaction[:started_at])
      %dt Duration
      %dd= compaction_duration(compaction)
      %dt Finished
      %dd= format_dashboard_time(compaction[:finished_at])
      %dt Run ID
      %dd= compaction[:run_id] || "—"

    - if schedules["dream_state_compaction"].present?
      %p.system-hint
        Scheduled: #{schedules["dream_state_compaction"]}

    - if compaction[:error].present?
      .system-warning.system-error
        %strong= "#{compaction[:error_class] || 'Error'}:"
        = compaction[:error]

      - if compaction[:error_backtrace].present?
        %details.system-card__details
          %summary Backtrace
          %pre.system-code= Array(compaction[:error_backtrace]).first(5).join("\n")

    .system-stats
      = dashboard_stat_chip("Processed", stats["entities_processed"] || 0)
      = dashboard_stat_chip("Auto merges", stats["merges_auto"] || 0)
      = dashboard_stat_chip("Queued merges", stats["merges_queued"] || 0)
      = dashboard_stat_chip("Deduped obs", stats["observations_deduped"] || 0)
      = dashboard_stat_chip("Orphans parented", stats["orphans_parented"] || 0)
      = dashboard_stat_chip("Orphans queued", stats["orphans_queued"] || 0)
      = dashboard_stat_chip("Relationships queued", stats["relationships_queued"] || 0)

  .system-actions
    - if compaction_pausable?(compaction)
      = button_to "Pause", system_pause_compaction_path, method: :post, class: "ui-btn system-btn--warning", id: "btn-dream-state-pause"
    - if compaction_resumable?(compaction)
      = button_to "Start / Resume", system_start_compaction_path, method: :post, class: "ui-btn ui-btn-primary", id: "btn-dream-state-resume"
    - if compaction[:error].present?
      = button_to "Repair relation duplicates", system_repair_relations_path, method: :post, class: "ui-btn system-btn--warning", id: "btn-repair-relations", data: { turbo_confirm: "Remove duplicate and conflicting relations (keeps oldest row per tuple)? Then use Start / Resume to retry compaction." }
    = link_to "Review suggestions", review_path, class: "ui-btn", id: "btn-compaction-review"

  %details.system-card__details
    %summary Raw dream-state snapshot
    %pre.system-code= JSON.pretty_generate(compaction)
