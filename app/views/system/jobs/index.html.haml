- content_for :title, t("system.jobs.title")
- content_for :page_header do
  = ui_page_header(t("system.jobs.title"), subtitle: t("system.jobs.subtitle")) do
    = link_to t("system.jobs.queue_link"), mission_control_jobs_path, class: "ui-btn", data: { turbo: false, testid: "jobs-queue-link" }
- snapshot = @snapshot
- totals = snapshot.dig(:graph_stats, :totals)

.projects-page{ data: { testid: "background-jobs" } }
  %p.projects-hint{ data: { testid: "background-jobs-totals" } }
    = t("system.jobs.totals", entities: number_with_delimiter(totals[:entities]), observations: number_with_delimiter(totals[:observations]),
      relations: number_with_delimiter(totals[:relations]), orphans: number_with_delimiter(snapshot.dig(:graph_stats, :orphan_count)))
  -# 1.84.0: the cards refresh themselves (live_refresh_controller.js, GET /system/jobs/cards).
  #jobs-cards{ data: { controller: "live-refresh", live_refresh_url_value: system_jobs_cards_path } }
    = render "system/jobs/cards", snapshot: snapshot
  %section.system-details
    = render "system/jobs/reports_details", latest_reports: snapshot[:latest_reports], compaction: snapshot[:compaction]
