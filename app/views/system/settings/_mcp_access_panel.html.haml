-# Settings › MCP access (UI-2a A3): the additive part of the three MCP allowlists. The ENV value
-# is shown as read-only text (never a form field, so it is never submitted); refused input → 422.
- group_key = local_assigns.fetch(:group_key)

= form_with url: system_settings_path, method: :patch, local: true, class: "dashboard-settings-form" do
  = hidden_field_tag :tab, group_key
  %p.dashboard-card__hint= t("operator.settings.mcp_access.intro")
  %p.dashboard-alert--warning{ data: { testid: "mcp-access-sessions-notice" } }
    %strong= t("operator.settings.mcp_access.sessions_notice_title")
    = t("operator.settings.mcp_access.sessions_notice")

  - mcp_access_rows.each do |row|
    .dashboard-settings-field{ data: { testid: "mcp-access-#{row[:kind]}" } }
      %label.dashboard-settings-field__label{ for: "setting_#{row[:key]}" }= t("operator.settings.fields.#{row[:key]}.label")
      %p.dashboard-settings-field__hint= t("operator.settings.fields.#{row[:key]}.description")
      .mcp-access-field
        %span.mcp-access-field__prefix{ title: row[:env_var], data: { testid: "mcp-env-#{row[:kind]}" } }
          %code= row[:env_var]
          = row[:env_value] || t("operator.settings.mcp_access.unset.#{row[:kind]}")
        = text_field_tag "settings[#{row[:key]}]", row[:input],
          id: "setting_#{row[:key]}", class: "dashboard-settings-field__input mcp-access-field__input",
          disabled: row[:disabled], placeholder: t("operator.settings.mcp_access.placeholder.#{row[:kind]}"),
          data: { testid: "setting-#{row[:key]}" }
      - if row[:disabled]
        %p.dashboard-alert--warning= t("operator.settings.mcp_access.unrestricted")
      - row[:env_warnings].each do |warning|
        %p.dashboard-alert--warning= t("operator.settings.mcp_access.env_never_matches", warning: warning)
      - row[:errors].each do |error|
        %p.dashboard-alert--danger{ data: { testid: "mcp-access-error-#{row[:kind]}" } }= error
      - row[:notes].each do |note|
        %p.dashboard-alert--warning{ data: { testid: "mcp-access-note-#{row[:kind]}" } }= note
      %p.dashboard-settings-field__validation{ data: { testid: "mcp-effective-#{row[:kind]}" } }
        = t("operator.settings.mcp_access.effective")
        - if row[:effective].any?
          = row[:effective].join(", ")
        - else
          = t("operator.settings.mcp_access.effective_none.#{row[:kind]}")

  %p.dashboard-card__hint= t("operator.settings.mcp_access.help")

  .dashboard-card__actions
    = submit_tag t("operator.settings.save_group"), class: "dashboard-btn dashboard-btn--primary",
      data: { testid: "operator-settings-save-btn-mcp_access" }
    = link_to t("operator.settings.reset"), system_settings_path(tab: group_key), class: "dashboard-btn dashboard-btn--secondary",
      data: { testid: "operator-settings-reset-btn-mcp_access" }
