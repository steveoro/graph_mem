{
  "_comment": "stdio scenarios (mcp-update-plan §3.0 stdio table + §3.1 Oct 22 additions). Each scenario runs in a fresh server process. `send` items are JSON values (sent as one line each) or {\"raw\": \"...\"} for bytes that aren't valid JSON. `expect` lists the replies graph_mem gives after PR-1/PR-2: matched by `id` (null-id replies in order); `result` is a subset match, `result_has` lists keys that must exist, `error_code` the JSON-RPC error code. `replies` is the exact number of reply lines (catches replies to notifications). Synthetic data only: no tool here writes.",
  "scenarios": [
    {
      "name": "initialize 2025-03-26 echoes",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}
      ],
      "expect": [{"id": 1, "result": {"protocolVersion": "2025-03-26"}}],
      "replies": 1
    },
    {
      "name": "initialize 2025-11-25 echoes; capabilities advertise no subscribe/listChanged",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}
      ],
      "expect": [{"id": 1, "result": {"protocolVersion": "2025-11-25", "capabilities": {"resources": {"subscribe": false, "listChanged": false}, "tools": {"listChanged": false}}}, "result_has": ["instructions", "serverInfo"]}],
      "replies": 1
    },
    {
      "name": "initialize 2026-07-28 -> 2025-11-25",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2026-07-28", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}
      ],
      "expect": [{"id": 1, "result": {"protocolVersion": "2025-11-25"}}],
      "replies": 1
    },
    {
      "name": "initialize \"9\" -> 2025-11-25",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "9", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}
      ],
      "expect": [{"id": 1, "result": {"protocolVersion": "2025-11-25"}}],
      "replies": 1
    },
    {
      "name": "server/discover + envelope -> -32601, id echoed (MG-5: answered like Memory 2.0.0)",
      "send": [
        {"jsonrpc": "2.0", "id": 7, "method": "server/discover", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": {}, "io.modelcontextprotocol/clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}}
      ],
      "expect": [{"id": 7, "error_code": -32601}],
      "replies": 1
    },
    {
      "name": "discover claiming 2027-01-01 -> -32601",
      "send": [
        {"jsonrpc": "2.0", "id": 7, "method": "server/discover", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2027-01-01", "io.modelcontextprotocol/clientCapabilities": {}, "io.modelcontextprotocol/clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}}
      ],
      "expect": [{"id": 7, "error_code": -32601}],
      "replies": 1
    },
    {
      "name": "envelope missing clientCapabilities -> -32601",
      "send": [
        {"jsonrpc": "2.0", "id": 7, "method": "server/discover", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}}
      ],
      "expect": [{"id": 7, "error_code": -32601}],
      "replies": 1
    },
    {
      "name": "tools/list + envelope, no initialize -> served",
      "send": [
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": {}, "io.modelcontextprotocol/clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}}
      ],
      "expect": [{"id": 2, "result_has": ["tools"]}],
      "replies": 1
    },
    {
      "name": "discover -> initialize 2025-11-25 -> tools/list (the auto-mode fallback path)",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "server/discover", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": {}, "io.modelcontextprotocol/clientInfo": {"name": "mcp-compat-drive", "version": "0"}}}},
        {"jsonrpc": "2.0", "id": 2, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 3, "method": "tools/list"}
      ],
      "expect": [{"id": 1, "error_code": -32601}, {"id": 2, "result": {"protocolVersion": "2025-11-25"}}, {"id": 3, "result_has": ["tools"]}],
      "replies": 3
    },
    {
      "name": "parse error / batch / missing jsonrpc / primitive -> -32700 / -32600 / -32600 / -32600",
      "send": [
        {"raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":"},
        [{"jsonrpc": "2.0", "id": 2, "method": "ping"}],
        {"id": 3, "method": "ping"},
        42
      ],
      "expect": [{"id": null, "error_code": -32700}, {"id": null, "error_code": -32600}, {"id": 3, "error_code": -32600}, {"id": null, "error_code": -32600}],
      "replies": 4
    },
    {
      "name": "unknown notification -> no reply",
      "send": [
        {"jsonrpc": "2.0", "method": "notifications/mcp_compat_unknown"},
        {"jsonrpc": "2.0", "id": 9, "method": "ping"}
      ],
      "expect": [{"id": 9, "result": {}}],
      "replies": 1
    },
    {
      "name": "\"id\": null tools/call -> -32600, id-less tools/call -> no reply, resources/subscribe -> -32601",
      "send": [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "mcp-compat-drive", "version": "0"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": null, "method": "tools/call", "params": {"name": "get_current_time", "arguments": {}}},
        {"jsonrpc": "2.0", "method": "tools/call", "params": {"name": "get_current_time", "arguments": {}}},
        {"jsonrpc": "2.0", "id": 4, "method": "resources/subscribe", "params": {"uri": "memory_graph"}},
        {"jsonrpc": "2.0", "id": 5, "method": "ping"}
      ],
      "expect": [{"id": 1, "result_has": ["protocolVersion"]}, {"id": null, "error_code": -32600}, {"id": 4, "error_code": -32601}, {"id": 5, "result": {}}],
      "replies": 4
    },
    {
      "name": "invalid UTF-8 object key -> -32700, and the loop survives",
      "send": [
        {"raw_bytes_hex": "7b226a736f6e727063223a22322e30222c226964223a312c226d6574686f64223a2270696e67222c22706172616d73223a7b22ff223a317d7d"},
        {"jsonrpc": "2.0", "id": 2, "method": "ping"}
      ],
      "expect": [{"id": null, "error_code": -32700}, {"id": 2, "result": {}}],
      "replies": 2
    }
  ]
}
