# systemd user unit for the graph_mem LLM host bridge (script/llm_bridge/README.md).
# Copy to ~/.config/systemd/user/llm-bridge.service, fix the path, then:
#   systemctl --user daemon-reload && systemctl --user enable --now llm-bridge
# No secrets here: the bridge reads its token (and the claude token) from files in
# ~/.local/state/agent-cli, each mode 0600.
[Unit]
Description=graph_mem LLM host bridge (agent CLIs, 127.0.0.1 only)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /path/to/graph_mem/script/llm_bridge/bridge.py serve --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
