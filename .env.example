# === Database ===
DB_PASSWORD=my_password
DB_NAME=graph_mem
DB_PORT=3307

# === Application ===
# Required for Docker (production mode). Get from: bin/rails credentials:edit
# RAILS_MASTER_KEY=
# NOTE: APP_PORT is hardcoded in Dockerfile and docker-compose.yml

# === MCP Access Control ===
# See docs/mcp_access_control.md. Both are optional; the defaults allow
# unauthenticated access from loopback and private (RFC1918) ranges only.
#
# Shared bearer token. When set, every /mcp request must send
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# GRAPH_MEM_MCP_TOKEN=
#
# Comma-separated addresses or CIDR ranges. Use "any" to lift the network
# restriction entirely - only honoured when GRAPH_MEM_MCP_TOKEN is also set.
# GRAPH_MEM_MCP_ALLOWED_IPS=192.168.0.0/24

# === Database Backup ===
DB_BACKUP_HOST_PATH=full/path/to/your/db/backup/folder

# === Embedding Service ===
# Same machine:  http://localhost:11434 (works for both Docker host-network and native dev)
# Remote LAN:    http://<workstation-ip>:11434
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMS=768

# === Summarization Service ===
# Uses a separate text-generation model from embeddings.
SUMMARY_URL=http://localhost:11434
SUMMARY_MODEL=qwen3:8b
SUMMARY_PROVIDER=ollama
SUMMARY_TIMEOUT=30
SUMMARY_MAX_TOKENS=256
