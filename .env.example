# === Database ===
DB_PASSWORD=my_password
DB_NAME=graph_mem
DB_PORT=3307

# === Application ===
# Required for Docker (production mode). Get from: bin/rails credentials:edit
# RAILS_MASTER_KEY=
# NOTE: APP_PORT is hardcoded in Dockerfile and docker-compose.yml

# === Read-only guest (optional) ===
# Blank password = guest login disabled. Must differ from the operator's username and password.
# GRAPH_MEM_GUEST_USERNAME=guest
# GRAPH_MEM_GUEST_PASSWORD=

# === MCP Access Control ===
# See docs/mcp_access_control.md. Both are optional; the defaults allow
# unauthenticated access from loopback and private (RFC1918) ranges only.
#
# Shared bearer token. When set, every /mcp request must send
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# GRAPH_MEM_MCP_TOKEN=<token>
#
# Make sure "headers" in .cursor/mcp.json are set to the same token and client name. Example:
# "headers": {
#   "Authorization": "Bearer <token>",
#   "X-MCP-Client": "cursor-<N>"
# }

#
# Leave the three allowlists below unset to let bin/up detect them; a value here overrides the
# detection. A custom IP list replaces the defaults: keep 127.0.0.0/8,::1 (and 172.16.0.0/12 in
# Docker). Settings > MCP access can add entries at runtime, on top of these.
#
# Comma-separated addresses or CIDR ranges. Use "any" to lift the network
# restriction entirely - only honoured when GRAPH_MEM_MCP_TOKEN is also set.
# Do not skip the Authorization header if the IP check is set.
# GRAPH_MEM_MCP_ALLOWED_IPS=127.0.0.0/8,::1,172.16.0.0/12,192.168.0.0/24

# Host names (any port) or host:port values that clients on other machines use to reach the
# server. localhost, 127.0.0.1 and ::1 are always accepted; any other Host gets 403
# (DNS-rebinding protection, always on).
# GRAPH_MEM_MCP_ALLOWED_HOSTS=192.168.0.10,graphmem.lan

# Browser-based MCP clients: exact scheme://host:port origins accepted beyond same-origin, also the
# only origins granted CORS on /mcp.
# GRAPH_MEM_MCP_ALLOWED_ORIGINS=http://localhost:3001

# STDIO-only tool profile: default, readonly, or maintenance.
GRAPH_MEM_MCP_PROFILE=default

# === Project scans (docs/container_scan_mounts.md) ===
# Host folder mounted read-only at the same path in the container and used as the scan root.
# Leave empty to use the HOME of the user running compose; set it explicitly for systemd/cron,
# where HOME may be unset.
GRAPH_MEM_SCAN_HOME=
# "off" disables scans without touching the mount.
# GRAPH_MEM_SCANS=on

# === Database Backup ===
DB_BACKUP_HOST_PATH=full/path/to/your/db/backup/folder

# === Embedding Service ===
# Same machine:  http://localhost:11434 (works for both Docker host-network and native dev)
# Remote LAN:    http://<workstation-ip>:11434
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMS=768

# === Summarization Service ===
# Uses a separate text-generation model from embeddings.
SUMMARY_URL=http://localhost:11434
SUMMARY_MODEL=qwen3:8b
SUMMARY_PROVIDER=ollama
SUMMARY_TIMEOUT=30
SUMMARY_MAX_TOKENS=256
SUMMARY_NUM_CTX=8192
